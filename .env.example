# LINCE - variaveis de ambiente
# Copie para .env (local) e cadastre as mesmas em Vercel > Settings > Environment Variables (Production).
# NUNCA comite o .env (ja esta no .gitignore).

# --- Banco (obrigatorio para toda a inteligencia: motor, grafo, ingestao, dossie) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Login (Supabase Auth): a chave anon e PUBLICA (exposta ao front pela tela
#     de login). Habilite "Email" em Supabase > Authentication. ALLOWED_EMAILS
#     (separada por virgula) restringe quem acessa mesmo com signup aberto. ---
SUPABASE_ANON_KEY=
ALLOWED_EMAILS=

# --- DOU / Imprensa Nacional (conta gratuita do INLABS) ---
INLABS_EMAIL=
INLABS_SENHA=

# --- Camada de IA (opcional; sem ela, atos sao gravados sem resumo) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Fontes que exigem chave (opcionais; sem elas o endpoint retorna 501 requires_key) ---
DATAJUD_API_KEY=
PORTAL_TRANSPARENCIA_API_KEY=

# --- Protecao opcional dos endpoints de ingestao (Authorization: Bearer <valor>) ---
CRON_SECRET=

# --- Notificacao de alertas (F2 "Arko Alerta"; opcional, SEM chave paga) ---
#     URL de webhook Slack/Discord/Teams/generico. Com ela, os HITS DE MONITOR
#     (watchlist) da ingestao do DOU sao empurrados p/ o canal. Sem ela: so in-app.
#     Slack: https://hooks.slack.com/services/...  Discord: .../webhooks/.../...
ALERT_WEBHOOK_URL=

# --- E-mail dos digests de painel (NOMOS F3; opcional, "pronto p/ ligar") ---
#     Resend (https://resend.com). Com AS DUAS setadas, o digest diario dos paineis
#     (scripts/send-painel-reports.js) e o botao "Enviar agora" mandam e-mail p/ o
#     owner_email do painel. Sem elas: o e-mail so degrada (skipped:"no_key"); o
#     webhook por painel continua funcionando. RESEND_FROM = remetente VERIFICADO.
RESEND_API_KEY=
RESEND_FROM=
